# ============================================================
# Minecraft AI Companion Configuration
# ============================================================

# --- AI Provider Configuration ---
# Local-first default. Options: 'ollama' | 'gemini' | 'openai' | 'openai_compatible'
AI_ENABLED=true
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b

# 1. Tooken Club / OpenAI-Compatible Provider
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama

# --- Social conversation ---
SOCIAL_MAX_RESPONDERS=2
SOCIAL_INITIATIVE_ENABLED=true
SOCIAL_MAX_TURNS=4

# 2. Official OpenAI Provider
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Google Gemini Provider
GEMINI_API_KEY=your_google_gemini_api_key

# --- Minecraft Server Connection ---
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=GeminiBot
MC_VERSION=1.20.4

# --- Bot Gameplay Settings ---
BOT_OWNER=kustash01
BOT_LANGUAGE=ru
BOT_INITIATIVE=balanced

# --- Dashboard & UI ---
UI_PORT=3001
LOG_LEVEL=info
